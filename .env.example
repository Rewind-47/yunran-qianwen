# ---------- 大模型（对话 / Agent 编排）----------
# 通义千问（阿里云百炼），推荐：同时覆盖对话、向量、图像三类能力
DASHSCOPE_API_KEY=
# DeepSeek，备选（未配置 DASHSCOPE_API_KEY 时生效）
DEEPSEEK_API_KEY=
# 模型名：qwen-plus / qwen-max / deepseek-chat
LLM_MODEL=qwen-plus

# 任意 OpenAI 兼容网关（vLLM / Ollama / 自建代理）：两者同时配置时优先于上面的厂商密钥
LLM_BASE_URL=
LLM_API_KEY=
LLM_LABEL=

# ---------- 图像生成（通义万相）----------
# 文生图：工艺参数 → 提示词 → 成品效果图
WANX_T2I_MODEL=wanx2.1-t2i-turbo
# 局部重绘：description_edit_with_mask
WANX_EDIT_MODEL=wanx2.1-imageedit
# 置为 false 可强制使用本地程序化渲染（离线演示）
ENABLE_IMAGE_API=true

# ---------- RAG ----------
# 向量通道：配置 DASHSCOPE_API_KEY 时自动启用，失败会回退词法召回
ENABLE_EMBEDDING=true
EMBEDDING_MODEL=text-embedding-v3

# ---------- 存储 ----------
# 生成图与编辑链路落盘；不配置则直接返回模型图 URL（经 /api/image-proxy 转发）
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
