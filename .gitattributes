# 统一换行符：源码一律 LF，避免 Windows 上 diff 全是换行噪音
* text=auto eol=lf

# 二进制资源，禁止 Git 做文本转换与行尾处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.glb   binary
*.gltf  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.pdf   binary
*.zip   binary
# Lock 文件在合并时不做逐行冲突
package-lock.json merge=binary
*.glb filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
